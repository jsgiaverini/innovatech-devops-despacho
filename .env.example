# Base de datos local. En ECS, las task definitions usan el alias Service Connect `mysql`.
DB_ENDPOINT=mysql
DB_PORT=3306
DB_NAME=innovatech
DB_USERNAME=appuser
DB_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me

# Nginx (solo para docker-compose local)
VENTAS_HOST=back-ventas:8080
DESPACHOS_HOST=back-despachos:8081
