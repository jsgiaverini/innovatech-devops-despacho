# Base de datos (para docker-compose local: DB_ENDPOINT=mysql; para ECS: DB_ENDPOINT=mysql.innovatech.local)
DB_ENDPOINT=mysql
DB_PORT=3306
DB_NAME=innovatech
DB_USERNAME=appuser
DB_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me

# Nginx (solo para docker-compose local)
VENTAS_HOST=back-ventas
DESPACHOS_HOST=back-despachos
